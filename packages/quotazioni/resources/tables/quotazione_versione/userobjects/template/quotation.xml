<content_css>/* =========================================================
   PAGINA
   ========================================================= */

@page {
    size: A4 portrait;
    margin: 0;
}


/* =========================================================
   RESET
   ========================================================= */

html,
body {
    margin: 0;
    padding: 0;
    width: 210mm;
    min-width: 210mm;
    max-width: 210mm;

    font-family: Tahoma, Geneva, sans-serif;
    font-size: 10px;
    color: #000000;
}

* {
    box-sizing: border-box;
}


/* =========================================================
   CONTENITORE DOCUMENTO
   A4 = 210mm
   10mm sinistra + 10mm destra
   contenuto = 190mm
   ========================================================= */

.page-content {
    width: 190mm;
    max-width: 190mm;

    margin-left: auto;
    margin-right: auto;

    padding-top: 6mm;
    padding-bottom: 10mm;
}


/* =========================================================
   HEADER AZIENDA
   ========================================================= */

.company-header {
    width: 190mm;
    max-width: 190mm;

    table-layout: fixed;
    border-collapse: collapse;

    margin: 0 0 15px 0;
    padding: 0;
}

.company-header td {
    padding: 0;
    margin: 0;
    vertical-align: top;
}

.company-logo {
    width: 50%;
    text-align: left;
}

.company-logo img {
    display: block;

    max-width: 90mm;
    max-height: 110px;

    width: auto;
    height: auto;
}

.company-data {
    width: 50%;

    text-align: right;

    font-size: 10px;
    line-height: 14px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}


/* =========================================================
   DATI DOCUMENTO / CLIENTE
   ========================================================= */

.document-info {
    width: 190mm;
    max-width: 190mm;

    table-layout: fixed;
    border-collapse: collapse;

    margin: 0 0 15px 0;
    padding: 0;
}

.document-info td {
    padding: 0;
    margin: 0;
    vertical-align: top;
}

.document-data {
    width: 50%;
    text-align: left;
    line-height: 14px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}

.customer-data {
    width: 50%;
    text-align: left;
    line-height: 14px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}


/* =========================================================
   TITOLI
   ========================================================= */

.section-title {
    width: 190mm;
    max-width: 190mm;

    margin-top: 8px;
    margin-bottom: 5px;

    font-size: 10px;
    line-height: 13px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}


/* =========================================================
   TESTO QUOTAZIONE
   ========================================================= */

.quotation-text {
    width: 190mm;
    max-width: 190mm;

    margin-top: 8px;
    margin-bottom: 10px;

    font-size: 11px;
    line-height: 15px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}


/* =========================================================
   TABELLE ARTICOLI
   ========================================================= */

.items-table {
    width: 190mm;
    max-width: 190mm;

    table-layout: fixed;
    border-collapse: collapse;

    margin: 3px 0 5px 0;
    padding: 0;

    font-size: 11px;
}

.items-table td {
    padding: 2px 3px;
    margin: 0;

    vertical-align: top;

    line-height: 15px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}

.description-column {
    width: 80%;
    text-align: left;
}

.amount-column {
    width: 20%;
    text-align: right;

    white-space: nowrap;
}


/* =========================================================
   TESTI
   ========================================================= */

.text-section {
    width: 190mm;
    max-width: 190mm;

    margin: 0;
    padding: 0;

    font-size: 11px;
    line-height: 15px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}

.services-excluded {
    line-height: 12px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.agency-footer {
    width: 190mm;
    max-width: 190mm;

    table-layout: fixed;
    border-collapse: collapse;

    margin-top: 15px;
    padding: 0;
}

.agency-footer td {
    padding: 0;
    margin: 0;
    vertical-align: top;
}

.agency-footer-space {
    width: 50%;
}

.agency-footer-content {
    width: 50%;

    text-align: left;

    font-size: 10px;
    line-height: 14px;

    overflow-wrap: break-word;
    word-wrap: break-word;
}


/* =========================================================
   IMMAGINI
   ========================================================= */

img {
    max-width: 100%;
    height: auto;
}


/* =========================================================
   PAGINAZIONE
   ========================================================= */

table {
    page-break-inside: auto;
}

tr {
    page-break-inside: avoid;
}

.section-title {
    page-break-after: avoid;
}</content_css>
